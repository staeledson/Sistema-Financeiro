# ─── Banco de dados ────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://app:app@localhost:5433/financas

# ─── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6380

# ─── Autenticação (Better Auth) ────────────────────────────────────────────────
# Gere com: openssl rand -hex 32
BETTER_AUTH_SECRET=

# URL pública da API (usada pelo Better Auth para callbacks e redirects)
BETTER_AUTH_URL=http://localhost:3100

# Porta da API (o proxy do Vite em apps/web/vite.config.ts aponta para ela)
PORT=3100

# Frontend (opcional): deixe vazio no dev local para usar o proxy Vite em /api
# VITE_API_URL=

# ─── LLM — OpenRouter ──────────────────────────────────────────────────────────
# Usado na ingestão por IA e no chat "Pergunte às suas finanças"
# https://openrouter.ai/keys
OPENROUTER_API_KEY=

# ─── STT — Groq Whisper ────────────────────────────────────────────────────────
# Usado na ingestão por áudio
# https://console.groq.com/keys
GROQ_API_KEY=

# ─── Object storage — MinIO ────────────────────────────────────────────────────
# Os valores abaixo correspondem ao docker-compose.yml padrão
MINIO_ENDPOINT=http://localhost:9010
MINIO_ACCESS_KEY=minio
MINIO_SECRET_KEY=minio123
MINIO_BUCKET=financas

# ─── Push notifications — VAPID ────────────────────────────────────────────────
# Opcional: sem essas variáveis as notificações push são silenciosas (no-op)
# Gere com: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
