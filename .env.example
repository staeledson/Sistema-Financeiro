# ─── Banco de dados ────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://app:app@localhost:5433/financas

# ─── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6380
# BULLMQ_PREFIX=bull  # namespace das filas BullMQ lido pela API (os testes da API usam bull-test); o worker usa o padrão bull

# ─── Autenticação (Better Auth) ────────────────────────────────────────────────
# Gere com: openssl rand -hex 32
BETTER_AUTH_SECRET=

# URL pública da API (usada pelo Better Auth para callbacks e redirects)
# Em produção (front na Vercel com rewrite de /api), use a origem pública do FRONT, não a da API.
BETTER_AUTH_URL=http://localhost:3100

# Origens extras confiáveis pelo Better Auth, separadas por vírgula (ex.: domínio próprio). Opcional.
# TRUSTED_ORIGINS=https://meu-app.vercel.app

# Lista de permissão de cadastro (emails separados por vírgula, sem diferenciar maiúsculas).
# Em PRODUÇÃO (NODE_ENV=production) o cadastro é FECHADO por padrão: com a variável vazia/ausente ninguém cria conta.
# Defina os emails permitidos; o valor exato "*" abre o cadastro para qualquer email (opt-in explícito).
# Fora de produção (dev/testes), vazia/ausente libera qualquer email.
# SIGNUP_ALLOWED_EMAILS=voce@exemplo.com

# Defina "true" quando a API roda atrás de proxy (Railway): confia nos cabeçalhos X-Forwarded-*.
# TRUST_PROXY=true

# Porta da API (o proxy do Vite em apps/web/vite.config.ts aponta para ela)
PORT=3100

# Fuso usado para "hoje" e "mês atual" no servidor (orçamentos, insights). Padrão America/Sao_Paulo.
# APP_TIMEZONE=America/Sao_Paulo

# ─── E-mail (convites) ─────────────────────────────────────────────────────────
# Sem MAIL_API_KEY o convite só aparece no log e na tela (modo dev).
# MAIL_API_KEY=
# Remetente verificado no Resend (obrigatório em produção para o convite chegar).
# MAIL_FROM=convites@seu-dominio.com.br

# ─── LLM — OpenRouter ──────────────────────────────────────────────────────────
# Usado na ingestão por IA e no chat "Pergunte às suas finanças"
# https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Política de coleta de dados enviada ao OpenRouter em toda chamada: "deny" (padrão) ou "allow".
# Qualquer outro valor vale "deny". Com "deny", modelos servidos só por provedores que coletam dados podem
# responder 404 "No endpoints found matching your data policy": troque o modelo ou use "allow" sabendo do risco.
OPENROUTER_DATA_COLLECTION=deny

# ─── STT — Groq Whisper ────────────────────────────────────────────────────────
# Usado na ingestão por áudio
# https://console.groq.com/keys
GROQ_API_KEY=

# ─── Object storage — MinIO ────────────────────────────────────────────────────
# Os valores abaixo correspondem ao docker-compose.yml padrão
MINIO_ENDPOINT=http://localhost:9010
MINIO_ACCESS_KEY=minio
MINIO_SECRET_KEY=minio123
MINIO_BUCKET=financas
# Região S3 (padrão us-east-1) e estilo de endereço do bucket (padrão true = path-style; "false" = virtual-hosted).
# Ajuste para o seu provedor (Railway Bucket, Cloudflare R2: region "auto"...). Vale para a API e o worker.
# MINIO_REGION=us-east-1
# MINIO_FORCE_PATH_STYLE=true

# ─── Push notifications — VAPID ────────────────────────────────────────────────
# Opcional: sem essas variáveis as notificações push são silenciosas (no-op)
# Gere com: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
